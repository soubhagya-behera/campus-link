# Local PostgreSQL — fill in once via scripts/Set-LocalEnv.ps1 (masked prompt).
# Never commit real credentials. See .env.example for placeholders.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/campuslink?schema=public"
PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Mail — required by POST /api/auth/register/start to email one-time codes.
# Until every one of these is set, registration answers 503 and no code is
# ever minted (there is deliberately no console/dev fallback that would let a
# student believe a code was sent). Names only below; never commit values.
#
# Gmail (recommended for a local demo):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=1          # 1 = implicit TLS (465). Use 587 with STARTTLS.
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char Google app password, NOT the account password>
#   MAIL_FROM="CAMPUSLINK <you@gmail.com>"   # must be a sender Gmail permits
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional. HMAC key for one-time codes. A random per-process key is generated
# automatically when this is unset, which is fine for a single local API but
# means codes do not survive a restart. Set a long random value (32+ bytes) if
# you ever run more than one API process.
# OTP_PEPPER=
